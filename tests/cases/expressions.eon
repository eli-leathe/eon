name = value
number = 42
string = "hello"
char = 'x'
enabled = true
disabled = false
array = [1, base + 2, [true, false]]
multiline_array = [
  first,
  second,
]
result = -user.profile.score * (base + 2) / scale - delta == target and ready or fallback

value = a - b - c / d / e
value = -a.b.c * (d + e) / f - g == h and i or j
applied = map user.profile (transform value) + fallback default
negated = -(measure sample)
